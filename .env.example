# Copy to .env.local for development, or .env.production for a deploy, and fill
# in the values. Both are gitignored. Nothing here is committed with a value.
#
# This is a public hostname, not a secret. Real secrets go in the Worker with
# `wrangler secret put`.

# Base URL of the ecommerce API, including /api/v1. Server-side only.
#
# Browsers never see this: they call the same-origin /api/v1/* path, which
# next.config.ts rewrites to this value. That proxy is why the storefront can
# stay on ashandmoss.com while the API lives on basilpot.com — no Origin header
# reaches the worker, so the API's CORS allowlist never applies to us.
API_BASE_URL=
# The API key this storefront authenticates with. Server-side only, and it is the
# thing that identifies the store — there is no store header and no host lookup.
# Mint one from the dashboard under Settings -> API keys, with read and write
# scopes (write is needed for POST /orders).
#
# Never prefix this with NEXT_PUBLIC_. That would inline it into the page and
# publish the key to every visitor.
STOREFRONT_API_KEY=
